// apps/api/src/services/campaign-sync.ts
const SYNC_DELAY_MS = 2000  // 2 seconds
```

### Scheduler

```typescript
// apps/api/src/jobs/scheduler.ts
this.scheduleJob('sync', '*/30 * * * *', ...)  // 30 minutes
```

