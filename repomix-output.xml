if (jobFailed) {
  const nextRetryAttempt = attemptNumber + 1
  if (nextRetryAttempt <= 5) {
    const delay = 30 * Math.pow(2, nextRetryAttempt)
    scheduleRetry(jobId, delay)
  } else {
    // Move to failed state
    jobState = 'failed'
  }
}
```

