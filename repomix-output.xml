  schema: process.env.PGBOSS_SCHEMA || 'pgboss',
  archives: true,
  archiveCompletedAfterSeconds: (process.env.PGBOSS_ARCHIVE_DAYS || 7) * 86400,
  retryLimit: parseInt(process.env.PGBOSS_RETRY_LIMIT || '5'),
