# ===========================================
# NativeHub 3.0 Environment Configuration
# ===========================================

# Database
DATABASE_URL=postgresql://user:password@host:5432/nativehub

# Security (32-byte hex key for AES-256-GCM)
ENCRYPTION_KEY=your-64-character-hex-key-here

# Better Auth
BETTER_AUTH_SECRET=your-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# App
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:3001

# ===========================================
# Production Environment (uncomment for deploy)
# ===========================================
# BETTER_AUTH_URL=https://api.nativehub.arakakileo.com
# FRONTEND_URL=https://nativehub.arakakileo.com
# VITE_API_URL=https://api.nativehub.arakakileo.com
# NODE_ENV=production
