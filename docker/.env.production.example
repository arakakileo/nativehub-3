# ===========================================
# NativeHub 3.0 Production Environment
# ===========================================
# Copy to .env.production and fill in actual values

# Database (Supabase via Docker network)
# IMPORTANT: Replace placeholders with actual values
DATABASE_URL=postgresql://USER:CHANGE_ME@nativehub-supabase-db:5432/DATABASE

# Security (32-byte hex key for AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api-nativehub.arakakileo.com
FRONTEND_URL=https://nativehub.arakakileo.com

# Frontend (build-time)
VITE_API_URL=https://api-nativehub.arakakileo.com

# ===========================================
# Monitoring Stack (Phase 11)
# ===========================================

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# AlertManager Discord webhook
# Create at: Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ===========================================
# WhatsApp Notifications (Evolution API)
# ===========================================

# Evolution API configuration
EVOLUTION_API_URL=https://evolution.arakakileo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=nativehub

# Admin notification number (country + DDD + number, no dashes)
ADMIN_WHATSAPP_NUMBER=556791983112
